{
  "name": "labkhand-nini-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "npx --yes prettier@3.6.2 --write \"app/**/*.{ts,tsx,js,jsx,css}\" \"lib/**/*.{ts,tsx,js,jsx,json}\" \"data/**/*.json\" \"types/**/*.{ts,tsx}\" \"*.{ts,tsx,json,md}\"",
    "format:check": "npx --yes prettier@3.6.2 --check \"app/**/*.{ts,tsx,js,jsx,css}\" \"lib/**/*.{ts,tsx,js,jsx,json}\" \"data/**/*.json\" \"types/**/*.{ts,tsx}\" \"*.{ts,tsx,json,md}\""
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "next": "16.4.0",
    "next-auth": "^5.0.0-beta.32",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
